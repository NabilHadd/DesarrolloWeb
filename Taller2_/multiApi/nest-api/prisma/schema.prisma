generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model pokemon {
  id        Int               @id
  name      String            @db.VarChar(200)
  height    Decimal?          @db.Decimal(10, 2)
  weight    Decimal?          @db.Decimal(10, 2)
  sprite    String            @db.VarChar(200)
  abilities pokemon_ability[]
  types     pokemon_type[]
}

model ability {
  id       Int               @id
  name     String            @db.VarChar(200)
  effect   String            @db.VarChar(200)
  pokemons pokemon_ability[]
}

model type {
  id       Int            @id
  name     String         @db.VarChar(200)
  sprite   String?        @db.VarChar(200)
  pokemons pokemon_type[]
}

model pokemon_type {
  id_type    Int
  id_pokemon Int
  pokemon    pokemon @relation(fields: [id_pokemon], references: [id], onDelete: NoAction, onUpdate: NoAction)
  type       type    @relation(fields: [id_type], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([id_pokemon, id_type])
}

model pokemon_ability {
  id_ability Int
  id_pokemon Int
  ability    ability @relation(fields: [id_ability], references: [id], onDelete: NoAction, onUpdate: NoAction)
  pokemon    pokemon @relation(fields: [id_pokemon], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([id_pokemon, id_ability])
}
